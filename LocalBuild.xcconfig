// LocalBuild.xcconfig
// Build configuration for local builds. Fork patch (2026-08-06): signs with the
// personal Apple Development certificate instead of ad-hoc. A stable signing
// identity keeps macOS TCC grants (Accessibility, Screen Recording, Microphone)
// valid across rebuilds; ad-hoc signatures change with every build and
// invalidate them. Note: this xcconfig takes precedence over xcodebuild
// command-line overrides.

CODE_SIGN_IDENTITY = Apple Development
CODE_SIGN_STYLE = Manual
DEVELOPMENT_TEAM = 86UWZN67H8
PROVISIONING_PROFILE_SPECIFIER =

// Entitlements are set via absolute path in the Makefile command line
// (relative paths break SPM package targets that resolve from their own source root)

// Add LOCAL_BUILD compilation flag so Swift code can use #if LOCAL_BUILD
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) LOCAL_BUILD
